# -----------------------------------------------------------------------------
# Translation API Keys
# -----------------------------------------------------------------------------

# Google Gemini configurations (Default implementation)
# Obtain your API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Google Cloud Translation API configurations
# Web-scraping-based Google translate will be used out-of-the-box if this is empty
GOOGLE_TRANS_API_KEY=
GOOGLE_USE_FREE_API=true


# -----------------------------------------------------------------------------
# Subtitle Styling Configurations (applicable to ASS subtitles)
# -----------------------------------------------------------------------------
SUB_FONT_NAME=Arial
SUB_FONT_SIZE=24
SUB_PRIMARY_COLOR=#000000
SUB_SECONDARY_COLOR=#00FFFF
SUB_OUTLINE_COLOR=#FFFFFF
SUB_BACK_COLOR=#00000080
SUB_BOLD=1
SUB_ITALIC=0
SUB_BORDER_STYLE=1
SUB_OUTLINE=2.0
SUB_SHADOW=1.0
SUB_ALIGNMENT=2
